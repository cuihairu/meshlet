# meshlet-agent systemd unit（安装指南：docs/guide/install.md）。
#
# agent 数据面已实装（ADR-007）：用 [dataplane] device_token 拉取自身结构化
# 计划 → 与本机内核对账 → 有变更/漂移才经 LinuxNetworkBackend 应用隧道/路由/
# NAT → 周期心跳。**绝不在服务端下发 Shell 命令**（§16.4）。
#
# 启用前必须具备（见安装指南 §4/§5）：
#   [dataplane] enabled = true、device_token 已写入 /etc/meshlet/agent.toml
#   （0600）、private_key_file 存在（0600）。缺任一项 agent 拒绝启动并说明
#   原因（[dataplane] 未开则只打印状态后正常退出，不碰内核）。
#
# 硬化项已逐项注释；真机走查尚未做——尤其 `PrivateDevices=true` 与
# `ProtectKernelTunables=false` 对本机数据面路径（wg/ip/iptables）的影响需要在
# 真实设备上验证，发现冲突时以最小放宽为原则调整并在此处记录。
#
# 后端直接继承 ambient capabilities，不经 sudo；需 Netlink 与 ip_forward 写入。

[Unit]
Description=Meshlet device agent
Documentation=https://github.com/cuihairu/meshlet
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=+sysctl -w net.ipv4.ip_forward=1
Type=simple
User=meshlet-agent
Group=meshlet-agent
ExecStart=/usr/local/bin/meshlet-agent /etc/meshlet/agent.toml
WorkingDirectory=/var/lib/meshlet-agent
StateDirectory=meshlet-agent
Restart=on-failure
RestartSec=5s

# --- 硬化：数据面只需 CAP_NET_ADMIN CAP_NET_RAW，别的一概不给 ---
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshlet-agent
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
