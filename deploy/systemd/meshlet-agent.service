# meshlet-agent systemd unit (install guide: docs/guide/install.md).
#
# The dataplane is implemented (ADR-007): the agent pulls its own structured
# plan with the [dataplane] device_token, reconciles it against the local
# kernel, applies tunnels/routes/NAT through LinuxNetworkBackend only when
# something changed or drifted, then heartbeats. **Shell commands are never
# pushed from the server side** (§16.4).
#
# Required before enabling (see install guide §4/§5):
#   [dataplane] enabled = true, device_token written to /etc/meshlet/agent.toml
#   (0600) and private_key_file present (0600). Missing any of these, the agent
#   refuses to start and says why ([dataplane] disabled only prints status and
#   exits cleanly, never touching the kernel).
#
# Hardening items are commented per line; the walk-through on real hardware is
# still outstanding -- above all the effect of `PrivateDevices=true` and
# `ProtectKernelTunables=false` on the local dataplane path (wg/ip/iptables)
# must be verified on a real device; relax conflicts minimally and record them
# here.
#
# The backend inherits ambient capabilities directly, without sudo; it needs
# Netlink and ip_forward writes.

[Unit]
Description=Meshlet device agent
Documentation=https://github.com/cuihairu/meshlet
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=+sysctl -w net.ipv4.ip_forward=1
Type=simple
User=meshlet-agent
Group=meshlet-agent
ExecStart=/usr/local/bin/meshlet-agent /etc/meshlet/agent.toml
WorkingDirectory=/var/lib/meshlet-agent
StateDirectory=meshlet-agent
Restart=on-failure
RestartSec=5s

# --- Hardening: the dataplane only needs CAP_NET_ADMIN CAP_NET_RAW, nothing else ---
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshlet-agent
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
