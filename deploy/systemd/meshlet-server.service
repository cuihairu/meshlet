# meshlet-server systemd unit (install guide: docs/guide/install.md).
#
# The control plane only needs to read /etc/meshlet, write /var/lib/meshlet and
# listen on the `bind` port. The default bind = 127.0.0.1:8080 (an unprivileged
# port, exposed through an HTTPS reverse proxy), so privileges are dropped to
# nothing (empty CapabilityBoundingSet=); binding a port below 1024 directly
# requires adding CAP_NET_BIND_SERVICE and adjusting this file.
#
# Install: cp deploy/systemd/meshlet-server.service /etc/systemd/system/
# then systemctl daemon-reload && systemctl enable --now meshlet-server

[Unit]
Description=Meshlet control plane server
Documentation=https://github.com/cuihairu/meshlet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshlet
Group=meshlet
ExecStart=/usr/local/bin/meshlet-server /etc/meshlet/meshlet.toml
WorkingDirectory=/var/lib/meshlet
StateDirectory=meshlet
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s

# --- Hardening: the control plane needs no privileges at all ---
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshlet
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
