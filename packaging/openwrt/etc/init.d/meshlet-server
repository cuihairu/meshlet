#!/bin/sh /etc/rc.common
# Meshlet hub server procd init (meshlet package).
# Renders /var/etc/meshlet-server.toml from /etc/config/meshlet on every
# start; UCI is the single source of truth. The hub private key is
# generated on first start when the dataplane is enabled (wg genkey).
START=99
USE_PROCD=1

PROG=/usr/bin/meshlet-server
CONF_DEFAULT=/var/etc/meshlet-server.toml
KEY_DIR=/etc/meshlet

# Ensure a WireGuard private key exists at $1, generating one via wg genkey
# on first use (mode 0600). Honest failure: no wg, no key, no start.
ensure_key() {
	local key="$1"
	[ -s "$key" ] && return 0
	mkdir -p "$KEY_DIR"
	chmod 0755 "$KEY_DIR"
	if ! command -v wg >/dev/null 2>&1; then
		logger -t meshlet-server "no wg tool; cannot generate $key"
		return 1
	fi
	umask 077
	wg genkey > "$key" || return 1
	chmod 0600 "$key"
	logger -t meshlet-server "generated $key"
	return 0
}

render_config() {
	local bind state_dir dataplane interface listen_port private_key_file
	config_get bind server bind '127.0.0.1:8080'
	config_get state_dir server state_dir '/var/lib/meshlet'
	config_get dataplane server dataplane '0'
	config_get interface server interface 'meshlet'
	config_get listen_port server listen_port '51820'
	config_get private_key_file server private_key_file "$KEY_DIR/hub.key"
	mkdir -p "$(dirname "$CONF_DEFAULT")" "$state_dir" "$KEY_DIR"
	{
		echo "bind = \"$bind\""
		echo "database_path = \"$state_dir/meshlet.db\""
		if [ "$dataplane" = "1" ]; then
			ensure_key "$private_key_file" || return 1
			echo "[dataplane]"
			echo "enabled = true"
			echo "interface = \"$interface\""
			echo "listen_port = $listen_port"
			echo "private_key_file = \"$private_key_file\""
		fi
	} > "$CONF_DEFAULT"
	return 0
}

start_service() {
	local enabled
	config_load meshlet
	config_get enabled server enabled '0'
	[ "$enabled" = "1" ] || return 0
	render_config || return 1
	procd_open_instance
	procd_set_param command "$PROG" "$CONF_DEFAULT"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	service_stop "$PROG"
}

reload_service() {
	stop
	start
}
